{
  "name": "efata-financials-sv",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:copy": "node scripts/dev-copy.mjs",
    "dev:session": "node scripts/dev-session.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''; git config core.hooksPath .githooks 2>/dev/null || true",
    "postinstall": "node scripts/postinstall.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:sensitive": "node scripts/check-sensitive.mjs --all",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "seed:finance-dummy": "node scripts/seed-finance-dummy.mjs",
    "generate-secret": "node scripts/generate-secret.js",
    "repair:reconciliation-accounts": "node scripts/repair-reconciliation-accounts.mjs",
    "clean": "rm -rf .svelte-kit node_modules/.vite",
    "backfill:konferens-2026q1": "node scripts/backfill-konferens-2026q1.mjs",
    "backfill:income-apr-jul": "node scripts/backfill-income-2026-apr-jul.mjs",
    "import:bank-books-2026": "node scripts/import-bank-books-2026.mjs"
  },
  "devDependencies": {
    "@lucide/svelte": "^0.515.0",
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/postcss": "^4.1.12",
    "autoprefixer": "^10.4.21",
    "bits-ui": "^2.9.4",
    "postcss": "^8.5.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.0.0",
    "vite": "^7.0.4",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@auth/core": "^0.35.0",
    "@auth/sveltekit": "^1.4.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.6.2",
    "clsx": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.3.1"
  }
}
